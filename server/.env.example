# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
SERVER_URL=http://localhost:3001
CLIENT_URL=http://localhost:5173

# ── Security ──────────────────────────────────────────────────────────────────
# IMPORTANT: change this to a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret

# ── LLM (AI Queries tab) ──────────────────────────────────────────────────────
# Set LLM_PROVIDER to "anthropic" (default) or "openai"
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-haiku-4-5-20251001  # optional override

# OPENAI_API_KEY=sk-...                # if using openai
# LLM_MODEL=gpt-4o-mini               # if using openai

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (password reset / OTP) ──────────────────────────────────────────────
# Without these, OTPs are printed to the server console (fine for dev)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=your-smtp-password
# EMAIL_FROM=noreply@confettiexports.com

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
SERVER_URL=http://localhost:3001
CLIENT_URL=http://localhost:5173

# ── Security ──────────────────────────────────────────────────────────────────
# IMPORTANT: change this to a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret

# ── LLM (AI Queries tab) ──────────────────────────────────────────────────────
# Set LLM_PROVIDER to "anthropic" (default), "openai", or "openrouter"
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-haiku-4-5-20251001  # optional override

# OPENAI_API_KEY=sk-...                # if using openai
# LLM_MODEL=gpt-4o-mini               # if using openai

# OPENROUTER_API_KEY=sk-or-...         # if using openrouter
# LLM_MODEL=openai/gpt-4o-mini        # if using openrouter (any OpenRouter model id)

# Caps the LLM response length. Defaults to 1024 if unset.
# Set to "unlimited" to let the model use as much as it needs (OpenAI/OpenRouter
# only - Anthropic requires a numeric cap, so "unlimited" falls back to 8192 there).
# Reasoning models (e.g. some OpenRouter models) count their internal "thinking"
# tokens against this too, so a low cap can leave the final answer empty.
# MAX_TOKENS=1024

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Google Sheets sync ────────────────────────────────────────────────────────
# Service account for private sheets (share the sheet with its client_email).
# Needs the Drive API enabled on the GCP project. Provide EITHER a path to the
# credentials JSON OR the JSON itself (base64 also accepted).
# GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON=
# Minutes between automatic syncs of enabled sheet sources (0 disables)
SHEETS_SYNC_INTERVAL_MINUTES=30
# Test hook: override the export base URLs to point at a local fixture server
# SHEETS_EXPORT_BASE_URL=

# ── Email (password reset / OTP) ──────────────────────────────────────────────
# Without these, OTPs are printed to the server console (fine for dev)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=your-smtp-password
# EMAIL_FROM=noreply@confettiexports.com

{
  "name": "Employee",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "title": "Full Name"
    },
    "employee_id": {
      "type": "string",
      "title": "Employee ID"
    },
    "division": {
      "type": "string",
      "title": "Division",
      "enum": [
        "Ceramics",
        "Textiles",
        "Siena",
        "Admin"
      ]
    },
    "role": {
      "type": "string",
      "title": "Role / Designation"
    },
    "employment_type": {
      "type": "string",
      "enum": [
        "Full-time",
        "Part-time",
        "Contract",
        "Intern"
      ],
      "title": "Employment Type"
    },
    "status": {
      "type": "string",
      "enum": [
        "Active",
        "On Leave",
        "Terminated",
        "Probation"
      ],
      "default": "Active",
      "title": "Status"
    },
    "joining_date": {
      "type": "string",
      "format": "date",
      "title": "Joining Date"
    },
    "monthly_salary": {
      "type": "number",
      "title": "Monthly Salary (\u20b9)"
    },
    "phone": {
      "type": "string",
      "title": "Phone"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "address": {
      "type": "string",
      "title": "Address"
    },
    "aadhar_number": {
      "type": "string",
      "title": "Aadhar Number"
    },
    "pan_number": {
      "type": "string",
      "title": "PAN Number"
    },
    "id_proof_url": {
      "type": "string",
      "title": "ID Proof (file)"
    },
    "contract_url": {
      "type": "string",
      "title": "Contract Document (file)"
    },
    "police_verification_url": {
      "type": "string",
      "title": "Police Verification (file)"
    },
    "police_verification_status": {
      "type": "string",
      "enum": [
        "Pending",
        "Submitted",
        "Verified",
        "Rejected"
      ],
      "title": "Police Verification Status"
    },
    "health_record_url": {
      "type": "string",
      "title": "Health Record (file)"
    },
    "blood_group": {
      "type": "string",
      "title": "Blood Group"
    },
    "emergency_contact_name": {
      "type": "string",
      "title": "Emergency Contact Name"
    },
    "emergency_contact_phone": {
      "type": "string",
      "title": "Emergency Contact Phone"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "full_name",
    "division",
    "role"
  ]
}